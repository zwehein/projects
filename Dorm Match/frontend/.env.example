# Flask API root only (must serve JSON under /api/...). Do NOT point at Expo Metro/Web (e.g. :8081).
# On macOS, port 5000 is often AirPlay Receiver — this repo defaults Flask to 5001 (see backend/run.py).
# Use your LAN IP so a physical device can reach the host.
EXPO_PUBLIC_API_URL=http://192.168.1.100:5001
